[package]
name = "otlp-gen"
version = "0.1.0"
edition = "2021"
license = "Apache-2.0"

# The OTLP data model (`heph session export --format otlp`), generated by `gen`
# from the .proto files beside this template (`buf.gen.otlp.yaml`).
# `protoc-gen-buffa-packaging` emits the module tree as `mod.rs`; `gen` copies
# this file next to it.
[lib]
path = "src/mod.rs"

[dependencies]
# The workspace pins it exactly, in step with `buffaVersion` in devenv.nix.
# `json`: proto3 JSON through serde, which OTLP/JSON is built on.
buffa = { workspace = true, features = ["json"] }
serde = { version = "1", features = ["derive"] }

[lints.clippy]
all = "allow"
