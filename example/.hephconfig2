# Every provider/driver is a `plugin`. A `builtin:` selects a compiled-in plugin
# by name; `path:`/`url:` points at a `*-plugin.json` manifest for a loadable
# cdylib (loaded in-process behind the stable ABI — native speed, no IPC). Each
# entry's `options:` map is passed to the plugin's construction.
plugins:
  - builtin: buildfile
    options:
      patterns:
        - BUILD
  - builtin: exec
  - builtin: bash
  # The go plugin: one manifest names the cdylib for this host. The provider + its
  # go_* drivers all come from that one library. Installed to the user-global
  # ~/.heph by the `gen-example` script (which runs `install-go-plugin`).
  #
  # That builds the cdylib from this tree, which is what you want when the
  # binary running the example was built from this tree too. To run the example
  # with an *installed release* `heph` instead, run `install-release-plugins`:
  # it installs the manifests published alongside that release, so host and
  # plugins come from one build. Mixing the two fails the stabby ABI check at
  # load with a page of type-report text.
  - path: ~/.heph/plugins/go/heph-go-plugin.json
    options:
      # Required. A pinned version → hermetic SDK download (reads nothing from
      # the host); or "host" → use the host `go` from PATH.
      gotool: "1.27.0"
      # SDK tarball SHA-256s, keyed "<version>/<goos>/<goarch>". Optional: an
      # absent host-platform entry downloads the SDK unverified (logged warning);
      # supply one to enforce verification (no built-in table — keeps the binary
      # free of release-specific data). Add a version by adding its rows here
      # (sha256 from https://go.dev/dl/?mode=json). Unused for gotool: "host".
      checksums:
        "1.27.0/linux/amd64": "675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685"
        "1.27.0/linux/arm64": "51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda"
        "1.27.0/darwin/amd64": "d3314e25496e4381d71a5c51d2907e7af655d199f6780b549f015bd85fef4986"
        "1.27.0/darwin/arm64": "90493b3bbd5e10f91d12153198bf1994fd756399b4fec93b49b0c6e2acdeeb3e"
      # The `heph-govet` binary the `lint` / `format` targets exec, as an addr.
      # Defaults to `//@heph/go/govet/<tag>:heph-govet` — an `http_fetch` target
      # that downloads the binary published in the plugin's own heph release, so
      # a released plugin needs no configuration at all. A plugin built from
      # source (what `install-go-plugin` installs here) reports v0.0.0-dev, which
      # no release publishes: point it at a build target in *this* workspace, or
      # at a released tag's download target.
      #govet: "//@heph/go/govet/v0.1.234:heph-govet"
  # Exec runners: a target can say *where* its command runs. See the
  # `execrunner` package for a worked example, and docs/EXEC_RUNNERS.md for the
  # contract. Neither plugin is compiled into the CLI; `gen-example` installs
  # both into ~/.heph (built from this tree), and `install-release-plugins`
  # installs them from the release an installed `heph` reports.
  #
  # The devenv runner describes a build environment. A target enters it with
  # `runner = "//execrunner:devenv_wrap"`, or a whole workspace does it once
  # with `runner:` in the exec/bash driver options above.
  - path: ~/.heph/plugins/devenv/heph-devenv-plugin.json
    options:
      # Which `devenv` to resolve against. Defaults to `devenv` on PATH.
      bin: "devenv"
  # The oci plugin: `docker_build` / `oci_load` / `oci_pull` / `oci_push`, plus
  # the `oci_runner` that runs targets inside a built image.
  - path: ~/.heph/plugins/oci/heph-oci-plugin.json
#fuse:
#  enabled: true
# Remote (shared) caches. Each entry is keyed by a name and has a `uri` plus
# `read`/`write` flags (both default true) and a `concurrency` request cap
# (default 10). Supported schemes: s3://, gs://, az://, http(s):// (credentials
# from the environment) and file:// / memory:// for local use. Blobs are
# gzip-compressed and streamed (never held whole in memory). Writes fan out to
# every writable cache in parallel (on a background task — the CLI stays open
# until the upload drains); reads try caches in measured-latency order and pull
# a whole revision from the first that has it. Measure/refresh the order with
# `heph tool cache measure-latency`.
#caches:
#  shared:
#    uri: s3://my-bucket/heph-cache
#    read: true
#    write: true
#    concurrency: 10
