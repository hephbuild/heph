#!/usr/bin/env python3
"""Select the workspace crates whose tests must run on every platform.

CI runs the full test suite on linux/amd64 only. darwin/arm64 and linux/arm64
run the tests of the crates that *own* platform-conditional code, plus
`crates/e2e` (and, separately, two Go smoke tests). This script computes that
set from the tree under test on every run, so there is no crate list to drift.

A package is selected when any file it owns has one of:

  - `cfg(...)`, `cfg!(...)` or `cfg_attr(...)` (which covers the `#[cfg]`
    inside `cfg_if!`) naming a `target_*` key, `unix` or `windows` -- in any
    position, including `not(...)` and `any(..., test)`, across whitespace and
    newlines, inner or outer attribute;
  - a `[target.'cfg(...)'.*]` or `[target.<triple>.*]` dependency table in its
    Cargo.toml (read from `cargo metadata`);
  - a build script that reads `CARGO_CFG_TARGET_*` or emits `rustc-cfg`;
  - `std::env::consts::{OS, ARCH, FAMILY}`.

It is a text scan on purpose. Neither cargo nor rustc can say where a cfg is
used, and evaluating predicates against `rustc --print cfg` would be wrong:
`cfg(unix)` is true on all three supported targets, yet it is exactly what
must select. Matches inside comments, doc comments and strings select too,
deliberately -- over-selecting costs test time, under-selecting costs
coverage. A `target_*` key outside the known set selects the crate and prints
a warning naming the file and key.

A package owns the `.rs` files under its directory, minus nested packages'
directories, hidden directories, `target/`, and anything under a `testdata/`
or `gen/` directory. `#[path = "..."]` and `include!("...")` are followed, so a
module kept outside the package directory still counts; symlinks are not.

`e2e` is always selected. `plugingo-e2e` (sharded on linux/amd64) and `bin-e2e`
(its own job on every platform) never are.

Output: one `-p <name>` per line, sorted. `--explain` prints why each crate was
selected (file:line and the matched key); `--json` prints all of it as JSON.
Exits non-zero if `cargo metadata` fails, if an always-selected crate is not in
the workspace, or if the selection is empty.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field

ALWAYS = ("e2e",)
NEVER = {
    "plugingo-e2e": "runs on linux/amd64 only, sharded in the go_e2e jobs",
    "bin-e2e": "runs in its own Binary E2E job on every platform",
}
KNOWN_TARGET_KEYS = {
    "target_os",
    "target_arch",
    "target_family",
    "target_vendor",
    "target_env",
}
BARE_KEYS = {"unix", "windows"}
SKIPPED_DIRS = {"testdata", "gen"}

# `cfg`, `cfg!` or `cfg_attr`, then `(`, not preceded by an identifier
# character (so `my_cfg(` and `xcfg!(` do not match).
CFG_OPEN = re.compile(r"(?<![A-Za-z0-9_])(cfg_attr|cfg)\s*(?:!\s*)?\(")
IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
STRING = re.compile(r'"(?:\\.|[^"\\])*"', re.S)
ENV_CONSTS = re.compile(r"consts\s*::\s*(OS|ARCH|FAMILY)\b")
ENV_CONSTS_GROUP = re.compile(r"consts\s*::\s*\{([^}]*)\}")
PATH_ATTR = re.compile(r'#\s*!?\s*\[\s*path\s*=\s*"([^"]+)"\s*\]')
INCLUDE = re.compile(r'(?<![A-Za-z0-9_])include\s*!\s*\(\s*"([^"]+)"\s*\)')
BUILD_ENV = re.compile(r"CARGO_CFG_TARGET_[A-Z_]+")
BUILD_RUSTC_CFG = re.compile(r"rustc-cfg")
# How far a `cfg(` is followed looking for its closing paren. A real predicate
# is short; an unbalanced one (in a comment, say) must not swallow the file.
MAX_CFG_LEN = 4096


@dataclass
class Reason:
    file: str
    line: int
    key: str

    def as_dict(self) -> dict:
        return {"file": self.file, "line": self.line, "key": self.key}


@dataclass
class Package:
    name: str
    root: str
    build_scripts: list[str]
    target_deps: list[str]
    manifest: str
    reasons: list[Reason] = field(default_factory=list)


def line_of(text: str, pos: int) -> int:
    return text.count("\n", 0, pos) + 1


def cfg_body(text: str, open_paren: int) -> str:
    """The text between `(` at `open_paren` and its matching `)`.

    String literals are skipped while counting, so a `)` inside one does not
    close the predicate. An unbalanced predicate yields what was read.
    """
    depth = 0
    i = open_paren
    end = min(len(text), open_paren + MAX_CFG_LEN)
    while i < end:
        c = text[i]
        if c == '"':
            m = STRING.match(text, i)
            if m is None:
                break
            i = m.end()
            continue
        if c == "(":
            depth += 1
        elif c == ")":
            depth -= 1
            if depth == 0:
                return text[open_paren + 1 : i]
        i += 1
    return text[open_paren + 1 : end]


def cfg_keys(body: str) -> list[str]:
    """The platform keys a cfg predicate names, in order, without duplicates.

    Identifiers only: string literals are values (`feature = "unix"`), never
    keys, so they are removed first.
    """
    keys: list[str] = []
    for ident in IDENT.findall(STRING.sub('""', body)):
        if (ident in BARE_KEYS or ident.startswith("target_")) and ident not in keys:
            keys.append(ident)
    return keys


def scan_text(text: str, rel: str, build_script: bool, warn) -> list[Reason]:
    reasons: list[Reason] = []
    for m in CFG_OPEN.finditer(text):
        open_paren = m.end() - 1
        for key in cfg_keys(cfg_body(text, open_paren)):
            line = line_of(text, m.start())
            if key.startswith("target_") and key not in KNOWN_TARGET_KEYS:
                warn(rel, line, key)
            reasons.append(Reason(rel, line, f"{m.group(1)}({key})"))
    for m in ENV_CONSTS.finditer(text):
        reasons.append(Reason(rel, line_of(text, m.start()), f"std::env::consts::{m.group(1)}"))
    for m in ENV_CONSTS_GROUP.finditer(text):
        for name in IDENT.findall(m.group(1)):
            if name in ("OS", "ARCH", "FAMILY"):
                reasons.append(Reason(rel, line_of(text, m.start()), f"std::env::consts::{name}"))
    if build_script:
        for m in BUILD_ENV.finditer(text):
            reasons.append(Reason(rel, line_of(text, m.start()), m.group(0)))
        for m in BUILD_RUSTC_CFG.finditer(text):
            reasons.append(Reason(rel, line_of(text, m.start()), "build script emits rustc-cfg"))
    return reasons


def has_skipped_component(path: str, workspace_root: str) -> bool:
    rel = os.path.relpath(path, workspace_root)
    parts = rel.split(os.sep)
    return any(p in SKIPPED_DIRS for p in parts)


class Scanner:
    def __init__(self, metadata: dict):
        self.workspace_root = os.path.realpath(metadata["workspace_root"])
        self.target_dir = os.path.realpath(metadata["target_directory"])
        self.warnings: list[dict] = []
        self.packages: list[Package] = []
        for pkg in metadata["packages"]:
            root = os.path.realpath(os.path.dirname(pkg["manifest_path"]))
            build_scripts = [
                os.path.realpath(t["src_path"])
                for t in pkg["targets"]
                if "custom-build" in t["kind"]
            ]
            target_deps = sorted(
                {d["target"] for d in pkg["dependencies"] if d.get("target")}
            )
            self.packages.append(
                Package(pkg["name"], root, build_scripts, target_deps, pkg["manifest_path"])
            )
        self.roots = {p.root for p in self.packages}

    def rel(self, path: str) -> str:
        return os.path.relpath(path, self.workspace_root)

    def warn(self, rel: str, line: int, key: str) -> None:
        msg = (
            f"{rel}:{line}: unknown target key '{key}'; its crate is selected anyway. "
            "If it is a real cfg key, add it to KNOWN_TARGET_KEYS in scripts/platform-crates."
        )
        self.warnings.append({"file": rel, "line": line, "key": key})
        print(f"platform-crates: warning: {msg}", file=sys.stderr)
        if os.environ.get("GITHUB_ACTIONS") == "true":
            print(f"::warning file={rel},line={line},title=platform-crates::{msg}", file=sys.stderr)

    def owned_files(self, pkg: Package):
        """Every `.rs` file under the package directory that it owns."""
        for dirpath, dirnames, filenames in os.walk(pkg.root, followlinks=False):
            keep = []
            for d in sorted(dirnames):
                full = os.path.join(dirpath, d)
                if d.startswith("."):
                    continue
                if os.path.realpath(full) == self.target_dir or (
                    dirpath == pkg.root and d == "target"
                ):
                    continue
                if full in self.roots and full != pkg.root:
                    continue  # a nested package owns its own directory
                if has_skipped_component(full, self.workspace_root):
                    continue
                keep.append(d)
            dirnames[:] = keep
            for f in sorted(filenames):
                if f.endswith(".rs"):
                    yield os.path.join(dirpath, f)

    def scan_package(self, pkg: Package) -> None:
        seen: set[str] = set()
        queue = [(path, path in pkg.build_scripts) for path in self.owned_files(pkg)]
        while queue:
            path, build_script = queue.pop(0)
            if path in seen or os.path.islink(path) or not os.path.isfile(path):
                continue
            if has_skipped_component(path, self.workspace_root):
                continue
            seen.add(path)
            with open(path, "rb") as fh:
                text = fh.read().decode("utf-8", errors="replace")
            pkg.reasons.extend(scan_text(text, self.rel(path), build_script, self.warn))
            base = os.path.dirname(path)
            for m in (*PATH_ATTR.finditer(text), *INCLUDE.finditer(text)):
                target = os.path.normpath(os.path.join(base, m.group(1)))
                if target not in seen:
                    queue.append((target, build_script))
        manifest_text = ""
        try:
            with open(pkg.manifest, encoding="utf-8", errors="replace") as fh:
                manifest_text = fh.read()
        except OSError:
            pass
        for target in pkg.target_deps:
            pos = manifest_text.find(target)
            line = line_of(manifest_text, pos) if pos >= 0 else 1
            pkg.reasons.append(
                Reason(self.rel(pkg.manifest), line, f"[target.{target}] dependencies")
            )
        pkg.reasons.sort(key=lambda r: (r.file, r.line, r.key))

    def run(self) -> None:
        for pkg in self.packages:
            self.scan_package(pkg)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--manifest-path", help="the workspace's Cargo.toml (default: cargo's lookup from the cwd)")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--explain", action="store_true", help="print why each crate is selected")
    mode.add_argument("--json", action="store_true", help="machine-readable output")
    args = parser.parse_args()

    cmd = [os.environ.get("CARGO", "cargo"), "metadata", "--no-deps", "--format-version", "1"]
    if args.manifest_path:
        cmd += ["--manifest-path", args.manifest_path]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        print(f"platform-crates: error: {' '.join(cmd)} failed:\n{proc.stderr}", file=sys.stderr)
        return 1
    scanner = Scanner(json.loads(proc.stdout))
    scanner.run()

    names = {p.name for p in scanner.packages}
    missing = [n for n in ALWAYS if n not in names]
    if missing:
        print(f"platform-crates: error: always-selected crate(s) {missing} are not workspace members", file=sys.stderr)
        return 1

    by_name = {p.name: p for p in scanner.packages}
    selected = sorted(
        {p.name for p in scanner.packages if p.reasons and p.name not in NEVER} | set(ALWAYS)
    )
    unknown = [n for n in selected if n not in names]
    if unknown:
        print(f"platform-crates: error: selected names that are not packages: {unknown}", file=sys.stderr)
        return 1
    if not selected:
        print("platform-crates: error: selected no crate", file=sys.stderr)
        return 1

    if args.json:
        out = {
            "packages": selected,
            "args": [a for n in selected for a in ("-p", n)],
            "reasons": {n: [r.as_dict() for r in by_name[n].reasons] for n in selected},
            "always": list(ALWAYS),
            "never": {
                n: {"why": why, "matched": bool(by_name[n].reasons)}
                for n, why in NEVER.items()
                if n in by_name
            },
            "warnings": scanner.warnings,
        }
        json.dump(out, sys.stdout, indent=2)
        print()
    elif args.explain:
        for n in selected:
            reasons = by_name[n].reasons
            if not reasons:
                print(f"{n}: always selected")
                continue
            print(f"{n}: {len(reasons)} site(s)")
            for r in reasons:
                print(f"  {r.file}:{r.line}: {r.key}")
        for n, why in NEVER.items():
            if n in by_name:
                print(f"{n}: never selected ({why})")
    else:
        for n in selected:
            print(f"-p {n}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
